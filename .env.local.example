# ============================================================
# Smile Forward — Variables de Entorno
# ============================================================
# Copia este archivo como .env.local y completa con tus valores:
#   cp .env.local.example .env.local
# ============================================================

# -----------------------------------------------------------
# SUPABASE (Obligatorias)
# Obtener desde: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# -----------------------------------------------------------
# SUPABASE SERVICE ROLE (Opcional — solo para admin server-side)
# ⚠️ NUNCA exponer al cliente. Solo se usa en Server Actions.
# -----------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# -----------------------------------------------------------
# RESEND (Opcional — para envío de emails)
# Obtener desde: https://resend.com/api-keys
# -----------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------
# APP URL (Opcional — para links, QR codes, etc.)
# -----------------------------------------------------------
# NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# ============================================================
# IA — Google Gemini (ver docs/IA.md)
# ============================================================
# Obligatoria. La usa solo el servidor (nunca NEXT_PUBLIC_).
GOOGLE_API_KEY=
# Opcionales: si no se definen, se usan los modelos vigentes por defecto.
# GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODELS=gemini-nano-banana-2.1,gemini-3-pro-image
# GEMINI_IMAGE_SIZE=2K
# VIDEO_PROVIDER=omni            # omni | veo
# OMNI_VIDEO_MODEL=gemini-omni-1.1-flash
# VEO_VIDEO_MODEL=veo-3.1-fast-generate-preview

# Aviso de nuevas solicitudes a la clínica. Si no se define, se avisa al
# owner de la organización de la clínica.
# CLINIC_NOTIFICATION_EMAIL=

# Obligatorio para que el cron de limpieza (/api/cron/cleanup) funcione.
# CRON_SECRET=

# ============================================================
# BILLING — Créditos prepago (Stripe + Flexprice)
# Ver docs/BILLING.md para el runbook completo de configuración.
# ============================================================

# --- Plataforma (super-admin) ---
# Emails (coma-separados) con acceso al panel de plataforma /superadmin.
PLATFORM_ADMIN_EMAILS=serviciosmensualesadrian@gmail.com

# --- Better Auth (panel multi-clínica) ---
# Si no se definen, usan NEXTAUTH_SECRET / NEXTAUTH_URL como fallback.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- Multi-tenant ---
# Clave pública de la clínica por defecto (fallback cuando el widget no envía
# una). Tras correr la migración 002, obtén la clave con:
#   SELECT public_widget_key FROM clinics WHERE slug = 'default';
DEFAULT_CLINIC_KEY=
# Mismo valor, expuesto al cliente para que el widget lo envíe (opcional).
NEXT_PUBLIC_CLINIC_KEY=

# --- Stripe (pasarela de recarga de créditos) ---
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs (one-time) de cada paquete de créditos.
# Ya creados en la cuenta Stripe "Brandboost" (modo LIVE, USD):
STRIPE_PRICE_STARTER=price_1ThsM3CUaVGaMCKZWs7ivJBC   # 50 créditos  ($45)
STRIPE_PRICE_GROWTH=price_1ThsMMCUaVGaMCKZRczfZjBg    # 200 créditos ($160)
STRIPE_PRICE_PRO=price_1ThsMaCUaVGaMCKZOx3uGUMX       # 1000 créditos ($700)

# --- Flexprice (metering / facturación, self-host) ---
# URL interna del API de Flexprice desplegado en Easypanel (incluye /v1).
FLEXPRICE_API_URL=http://flexprice-api:8080/v1
FLEXPRICE_API_KEY=
# Environment de Flexprice al que se enrutan los eventos (header X-Environment-ID).
# Por defecto el "Production" sembrado. Requerido para que los eventos persistan.
FLEXPRICE_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000001
